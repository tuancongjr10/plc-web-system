# Copy this file to backend/.env and replace secret values locally.
# Never commit backend/.env.
NODE_ENV=production
HOST=0.0.0.0
PORT=80

DEMO_MODE=false
PLC_DEFAULT_IP=192.168.0.1
PLC_DEFAULT_PORT=2000
PLC_POLL_INTERVAL_MS=1000
PLC_STATUS_POLL_MS=1000
PLC_TELEMETRY_FRESH_MS=5000
PLC_RESPONSE_TIMEOUT_MS=1000
PLC_CONNECTION_TIMEOUT_MS=3000

# Production frontend is served by the backend on the same origin.
# CORS_ORIGIN is mainly needed when using the separate Vite development server.
# Example development value:
# CORS_ORIGIN=http://192.168.0.100:5173
CORS_ORIGIN=http://robolinks-tcjr

# Generate a long random value locally. Do not reuse this placeholder.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

DB_PATH=./database/plc_system.db
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Rendered label PDFs are retained for troubleshooting, then safely cleaned up.
PRINT_LABEL_TEMP_RETENTION_HOURS=48

# Stop background spooler reconciliation after this horizon.
PRINT_SPOOLER_RECONCILE_MAX_HOURS=12

# Optional mapping when a product barcode must be mapped explicitly to PLC JOB fields.
# Products can also store plc_product_id / recipe_id / target_qty in SQLite.
# PLC_JOB_MAP={"PROD-001":{"productId":1,"recipeId":1,"targetQty":1}}
