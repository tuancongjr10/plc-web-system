{
  "name": "plc-web-system-backend",
  "version": "1.0.0",
  "description": "PLC Web System Backend - Printer, Scanner, PLC Control",
  "main": "src/app.js",
  "scripts": {
    "start": "node scripts/start-production.js",
    "dev": "nodemon src/app.js",
    "build:frontend": "npm --prefix ../frontend run build",
    "service:install": "node scripts/windows-service.js install",
    "service:uninstall": "node scripts/windows-service.js uninstall",
    "service:start": "node scripts/windows-service.js start",
    "service:stop": "node scripts/windows-service.js stop",
    "service:status": "node scripts/windows-service.js status",
    "hostname:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-friendly-hostname.ps1",
    "test": "node --test test/*.test.js",
    "test:smoke": "node scripts/smoke-test.js",
    "db:init": "node src/models/initDb.js",
    "db:seed": "node src/models/seedDb.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "bwip-js": "^4.11.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-thermal-printer": "^4.4.2",
    "pdf-to-printer": "^5.8.0",
    "pdfkit": "^0.19.1",
    "uuid": "^9.0.0",
    "winston": "^3.12.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "nodemon": "^3.1.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
